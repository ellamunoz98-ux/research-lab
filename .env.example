# =================================================================
# 评论系统配置（三选一，按优先级 Worker > Giscus > Waline）
# =================================================================

# ----- 选项 A：自建 Cloudflare Worker（推荐，私有仓库适用）-----
# 部署方式见 worker/README.md
# 部署后填入 Worker URL：
PUBLIC_COMMENTS_API=

# ----- 选项 B：Giscus（基于 GitHub Discussions，需公开仓库）-----
# 配置流程：
# 1. 仓库 Settings → 勾选 Discussions
# 2. 安装 https://github.com/apps/giscus
# 3. 访问 https://giscus.app/zh-CN 拿到下方 4 个值
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=
PUBLIC_GISCUS_CATEGORY_ID=

# ----- 选项 C：Waline（自建后端，支持完全匿名）-----
# 详见：https://waline.js.org/guide/get-started.html
PUBLIC_WALINE_SERVER_URL=
