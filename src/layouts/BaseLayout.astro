---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MarketMarquee from "../components/MarketMarquee.tsx";
import ChatWidget from "../components/ChatWidget.tsx";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = "深度行业研究 · 股票投研报告 · 数据驱动决策",
  ogImage = "/og-default.png",
} = Astro.props;

const siteName = "Research Lab";
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;

// 复用评论用的 Worker URL；同一个 Worker 既处理评论也处理 /chat 端点
const chatApi = import.meta.env.PUBLIC_COMMENTS_API as string | undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <MarketMarquee client:only="react" />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    {chatApi && <ChatWidget client:only="react" apiUrl={chatApi} />}
  </body>
</html>
