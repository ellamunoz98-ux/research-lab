---
interface Props {
  /** PDF 文件名（相对于 public/pdfs/） */
  file: string;
  /** 报告标题，用于下载文件名 */
  title?: string;
  /** 总页数（可选，仅展示） */
  pages?: number;
  /** 是否允许下载/新窗口打开（默认 true）。设为 false：隐藏下载按钮 + 隐藏 PDF 工具栏 + 加水印 */
  download?: boolean;
  /** 高度，默认自适应 */
  height?: string | number;
  /** 是否懒加载 iframe（在 accordion 等场景里建议 true） */
  lazy?: boolean;
}

const {
  file,
  title,
  pages,
  download = true,
  height,
  lazy = false,
} = Astro.props;

const src = `/pdfs/${file}`;
const downloadName = title ? `${title}.pdf` : file;
const safeId = file.replace(/[^a-z0-9]/gi, "_");
const iframeHash = download
  ? "#view=FitH&toolbar=1&navpanes=0"
  : "#view=FitH&toolbar=0&navpanes=0&statusbar=0";
---

<section class="pdf-viewer my-6" data-pdf-id={safeId}>
  <!-- 顶部工具栏 -->
  <div class="glass flex items-center justify-between flex-wrap gap-3 px-5 py-3 mb-2 rounded-t-2xl rounded-b-none border-b border-border-subtle">
    <div class="flex items-center gap-2 text-sm">
      <svg class="w-5 h-5 text-cyan-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
      </svg>
      <span class="text-text-primary font-medium">PDF 原版</span>
      {pages && <span class="text-text-muted text-xs font-mono">· {pages} 页</span>}
      {!download && (
        <span class="text-rose-accent text-xs font-mono ml-2 px-1.5 py-0.5 rounded border border-rose-accent/30 bg-rose-accent/5">
          仅在线浏览
        </span>
      )}
    </div>

    <div class="flex items-center gap-1">
      {download && (
        <>
          <a
            href={src}
            target="_blank"
            rel="noopener"
            class="px-3 py-1.5 text-xs rounded-md border border-border-default text-text-secondary hover:border-cyan-accent hover:text-cyan-accent transition-all flex items-center gap-1.5"
            title="新窗口打开"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
            </svg>
            新窗口
          </a>
          <a
            href={src}
            download={downloadName}
            class="px-3 py-1.5 text-xs rounded-md border border-border-default text-text-secondary hover:border-cyan-accent hover:text-cyan-accent transition-all flex items-center gap-1.5"
            title="下载原文件"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
            下载
          </a>
        </>
      )}
      <button
        type="button"
        class="px-3 py-1.5 text-xs rounded-md border border-border-default text-text-secondary hover:border-cyan-accent hover:text-cyan-accent transition-all flex items-center gap-1.5"
        title="全屏阅读"
        data-pdf-fs={safeId}
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
        </svg>
        全屏
      </button>
    </div>
  </div>

  <!-- PDF 内嵌 -->
  <div class="pdf-frame-wrap glass !rounded-t-none border-t-0 overflow-hidden relative">
    <iframe
      src={`${src}${iframeHash}`}
      class="pdf-iframe w-full block bg-bg-card"
      style={height ? `height: ${typeof height === "number" ? `${height}px` : height};` : undefined}
      title={title ?? "PDF 查看器"}
      loading={lazy ? "lazy" : "eager"}
      data-pdf-frame
    ></iframe>
    {!download && (
      <div class="pdf-watermark" aria-hidden="true"></div>
    )}
  </div>

  <noscript>
    <p class="mt-3 text-xs text-text-muted">
      浏览器无法预览 PDF{download && <>，请 <a href={src} class="text-cyan-accent underline">点击下载</a></>}。
    </p>
  </noscript>
</section>

<style>
  .pdf-iframe {
    height: clamp(600px, 90vh, 1200px);
  }
  .pdf-viewer:fullscreen {
    background: var(--color-bg-base);
    padding: 1rem;
  }
  .pdf-viewer:fullscreen .pdf-iframe {
    height: calc(100vh - 80px);
  }
  /* 水印：只在 download=false 时出现 */
  .pdf-watermark {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='420' height='220'><text x='50%' y='50%' fill='rgba(34,211,238,0.06)' font-size='15' font-family='sans-serif' text-anchor='middle' transform='rotate(-22 210 110)'>Research.Lab · 仅供讨论 · 禁止下载传播</text></svg>");
    background-repeat: repeat;
  }
</style>

<script>
  // 全屏切换（事件委托，支持多个 PDFViewer 实例）
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest<HTMLElement>("[data-pdf-fs]");
    if (!btn) return;
    const wrap = btn.closest<HTMLElement>(".pdf-viewer");
    if (!wrap) return;
    if (document.fullscreenElement) {
      document.exitFullscreen();
    } else {
      wrap.requestFullscreen?.().catch(() => {
        const iframe = wrap.querySelector<HTMLIFrameElement>("[data-pdf-frame]");
        if (iframe) window.open(iframe.src, "_blank");
      });
    }
  });
</script>
