---
import type { CollectionEntry } from "astro:content";

interface Props {
  report: CollectionEntry<"reports">;
}

const { report } = Astro.props;
const { data, id } = report;

const accentMap = {
  cyan: "from-cyan-accent/20 to-cyan-accent/5 border-cyan-accent/30 text-cyan-accent",
  purple: "from-purple-accent/20 to-purple-accent/5 border-purple-accent/30 text-purple-accent",
  emerald: "from-emerald-accent/20 to-emerald-accent/5 border-emerald-accent/30 text-emerald-accent",
  rose: "from-rose-accent/20 to-rose-accent/5 border-rose-accent/30 text-rose-accent",
  blue: "from-blue-accent/20 to-blue-accent/5 border-blue-accent/30 text-blue-accent",
};
const accentClass = accentMap[data.accent];

const ratingColor = {
  "买入": "text-emerald-accent",
  "增持": "text-cyan-accent",
  "中性": "text-text-secondary",
  "减持": "text-rose-accent",
  "卖出": "text-rose-accent",
};

const formattedDate = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
}).format(data.publishDate);

const isPDF = !!data.pdfFile;
---

<a
  href={`/reports/${id}`}
  class="group glass relative overflow-hidden p-6 flex flex-col gap-4 h-full"
>
  <!-- 背景渐变 -->
  <div
    class:list={[
      "absolute -top-20 -right-20 w-60 h-60 rounded-full bg-gradient-to-br blur-3xl opacity-40 group-hover:opacity-70 transition-opacity duration-500 pointer-events-none",
      accentClass.split(" ").slice(0, 2).join(" "),
    ]}
  >
  </div>

  <div class="relative flex items-center justify-between gap-2">
    <div class="flex items-center gap-2 min-w-0">
      <span
        class:list={[
          "text-xs font-mono px-2 py-0.5 rounded border whitespace-nowrap",
          accentClass.split(" ").slice(2).join(" "),
        ]}
      >
        {data.industry}
      </span>
      <span
        class:list={[
          "text-xs font-mono px-1.5 py-0.5 rounded border whitespace-nowrap flex items-center gap-1",
          isPDF
            ? "border-amber-400/40 bg-amber-400/10 text-amber-400"
            : "border-cyan-accent/40 bg-cyan-accent/10 text-cyan-accent",
        ]}
        title={isPDF ? "PDF 原版报告" : "MDX 交互报告"}
      >
        {isPDF ? "📄 原版" : "⚡ 互动"}
      </span>
    </div>
    {data.rating && (
      <span class="text-xs font-mono flex items-center gap-1 shrink-0">
        <span class={ratingColor[data.rating]}>● {data.rating}</span>
      </span>
    )}
  </div>

  <div class="relative flex-1">
    <h3 class="text-xl font-semibold text-text-primary group-hover:text-cyan-accent transition-colors leading-snug mb-2">
      {data.title}
    </h3>
    {data.subtitle && <p class="text-sm text-text-secondary mb-3 leading-relaxed">{data.subtitle}</p>}
    <p class="text-sm text-text-secondary line-clamp-3 leading-relaxed">
      {data.summary}
    </p>
  </div>

  <div class="relative flex items-center justify-between pt-4 border-t border-border-subtle">
    <div class="flex items-center gap-3 text-xs text-text-muted font-mono">
      <span>{formattedDate}</span>
      {data.readingTime && <span>· {data.readingTime}</span>}
    </div>
    <span class="text-xs text-text-muted group-hover:text-cyan-accent group-hover:translate-x-1 transition-all flex items-center gap-1">
      阅读 →
    </span>
  </div>
</a>
