const accentMap = {
  cyan: "from-cyan-accent/20 to-cyan-accent/5 border-cyan-accent/30",
  rose: "from-rose-accent/20 to-rose-accent/5 border-rose-accent/30",
  purple: "from-purple-accent/20 to-purple-accent/5 border-purple-accent/30",
  emerald: "from-emerald-accent/20 to-emerald-accent/5 border-emerald-accent/30",
  blue: "from-blue-accent/20 to-blue-accent/5 border-blue-accent/30",
  amber: "from-amber-400/20 to-amber-400/5 border-amber-400/30",
};

const actionColor = {
  加息: "text-rose-accent border-rose-accent/40 bg-rose-accent/10",
  降息: "text-emerald-accent border-emerald-accent/40 bg-emerald-accent/10",
  维持: "text-text-secondary border-border-default bg-bg-card",
};
---

<div>
  <div class="mb-5">
    <div class="text-xs text-cyan-accent tracking-[0.3em] font-mono mb-2">CENTRAL BANKS</div>
    <h2 class="text-2xl font-bold text-text-primary">主要央行政策利率</h2>
    <p class="text-xs text-text-secondary mt-1">
      数据更新于 2026-05 · 实际决议以官方公告为准
    </p>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
    {
      BANKS.map((b) => {
        const diff = b.rate - b.prevRate;
        const diffBp = Math.round(diff * 100);
        return (
          <div class={`glass p-5 relative overflow-hidden bg-gradient-to-br ${accentMap[b.accent]}`}>
            <div class="absolute -top-12 -right-12 w-32 h-32 rounded-full opacity-30 blur-2xl pointer-events-none" style={`background: radial-gradient(circle, var(--color-${b.accent === 'amber' ? 'rose' : b.accent}-accent), transparent)`}></div>

            <div class="relative">
              <div class="flex items-start justify-between mb-3">
                <div>
                  <div class="text-2xl mb-1">{b.flag}</div>
                  <div class="text-text-primary font-semibold">{b.name}</div>
                  <div class="text-[10px] text-text-muted font-mono">{b.shortName}</div>
                </div>
                <span class:list={["text-[10px] px-1.5 py-0.5 rounded border whitespace-nowrap", actionColor[b.lastAction]]}>
                  {b.lastAction}
                  {diffBp !== 0 && ` ${diffBp > 0 ? '+' : ''}${diffBp}bp`}
                </span>
              </div>

              <div class="text-xs text-text-muted mb-1">{b.rateName}</div>
              <div class="text-3xl font-bold text-text-primary tabular mb-3">
                {b.rate.toFixed(2)}<span class="text-sm text-text-secondary ml-0.5">%</span>
              </div>

              <div class="text-[11px] space-y-1 mt-4 pt-3 border-t border-border-subtle">
                <div class="flex justify-between text-text-secondary">
                  <span>上次决议</span>
                  <span class="text-text-primary font-mono">{b.lastChange}</span>
                </div>
                <div class="flex justify-between text-text-secondary">
                  <span>下次会议</span>
                  <span class="text-cyan-accent font-mono">{b.nextMeeting}</span>
                </div>
                <div class="flex justify-between text-text-secondary">
                  <span>行长</span>
                  <span class="text-text-primary truncate ml-2 text-right">{b.governor}</span>
                </div>
              </div>

              <p class="text-[11px] text-text-secondary mt-3 leading-relaxed line-clamp-2" title={b.notes}>
                {b.notes}
              </p>
            </div>
          </div>
        );
      })
    }
  </div>
</div>
