---
/**
 * 央行决议看板（静态数据，定期手动更新）
 * 数据更新日期：2026-05
 */

interface CentralBank {
  id: string;
  flag: string;
  name: string;
  shortName: string;
  rateName: string;
  rate: number;        // 当前主要利率（%）
  prevRate: number;    // 上次决议前
  lastChange: string;  // 最近一次变动日期
  lastAction: "加息" | "降息" | "维持";
  nextMeeting: string; // 下次会议（YYYY-MM-DD 或描述）
  governor: string;
  notes: string;
  accent: "cyan" | "rose" | "purple" | "emerald" | "blue" | "amber";
}

const BANKS: CentralBank[] = [
  {
    id: "fed",
    flag: "🇺🇸",
    name: "美联储",
    shortName: "Fed",
    rateName: "联邦基金利率",
    rate: 4.25,
    prevRate: 4.50,
    lastChange: "2026-03-19",
    lastAction: "降息",
    nextMeeting: "2026-06-18",
    governor: "Jerome Powell",
    notes: "通胀回落但 PCE 仍高于 2% 目标，3 月降息 25bp，市场定价年内还有 1–2 次降息",
    accent: "blue",
  },
  {
    id: "ecb",
    flag: "🇪🇺",
    name: "欧洲央行",
    shortName: "ECB",
    rateName: "存款机制利率",
    rate: 2.50,
    prevRate: 2.75,
    lastChange: "2026-04-10",
    lastAction: "降息",
    nextMeeting: "2026-06-05",
    governor: "Christine Lagarde",
    notes: "欧元区通胀回落至 2.1%，但服务业通胀仍高，4 月降息 25bp",
    accent: "purple",
  },
  {
    id: "boe",
    flag: "🇬🇧",
    name: "英格兰银行",
    shortName: "BoE",
    rateName: "银行利率",
    rate: 4.25,
    prevRate: 4.50,
    lastChange: "2026-02-06",
    lastAction: "降息",
    nextMeeting: "2026-05-22",
    governor: "Andrew Bailey",
    notes: "工资增速放缓，2 月降息 25bp，市场预期年内继续宽松",
    accent: "blue",
  },
  {
    id: "boj",
    flag: "🇯🇵",
    name: "日本央行",
    shortName: "BoJ",
    rateName: "短期政策利率",
    rate: 0.50,
    prevRate: 0.25,
    lastChange: "2026-01-24",
    lastAction: "加息",
    nextMeeting: "2026-06-17",
    governor: "Kazuo Ueda",
    notes: "工资—物价良性循环成立，1 月加息 25bp，是后零利率时代第三次",
    accent: "rose",
  },
  {
    id: "pboc",
    flag: "🇨🇳",
    name: "中国人民银行",
    shortName: "PBoC",
    rateName: "1 年期 LPR",
    rate: 3.10,
    prevRate: 3.10,
    lastChange: "2025-10-20",
    lastAction: "维持",
    nextMeeting: "2026-05-20",
    governor: "潘功胜",
