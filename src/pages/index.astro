---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ReportCard from "../components/ReportCard.astro";
import FinancialGlobe from "../components/FinancialGlobe.tsx";
import { getCollection } from "astro:content";

const allReports = await getCollection("reports", ({ data }) => !data.draft);
const latestReports = allReports
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const features = [
  {
    icon: "◇",
    title: "数据驱动",
    desc: "数据流可溯源，每个图表背后都有原始数据集与处理脚本",
    color: "cyan-accent",
  },
  {
    icon: "◈",
    title: "深度分析",
    desc: "不止于宏观叙事，下沉到产业链节点、公司财报、政策文本",
    color: "purple-accent",
  },
  {
    icon: "◆",
    title: "可视交互",
    desc: "图表非静态截图，可悬停、缩放、对比，支持多维度切换",
    color: "emerald-accent",
  },
  {
    icon: "◉",
    title: "持续更新",
    desc: "重要数据按月跟踪，对错误公开订正，研究框架持续演进",
    color: "rose-accent",
  },
];
---

<BaseLayout title="Research.Lab">
  <Hero />

  <!-- 全球金融版图 -->
  <section id="globe" class="py-24 px-6 max-w-7xl mx-auto">
    <div class="text-center mb-10" data-reveal>
      <div class="text-xs text-cyan-accent tracking-[0.3em] font-mono mb-3">GLOBAL MARKETS</div>
      <h2 class="text-4xl md:text-5xl font-bold mb-4 text-text-primary leading-tight">
        全球金融<span class="gradient-text">版图</span>
      </h2>
      <p class="text-text-secondary max-w-2xl mx-auto leading-relaxed">
        点击地球任意金融中心，查看该地区的代表性指数、加密资产与商品行情。
        <br class="hidden md:block" />
        数据来自东方财富 / CoinGecko 公开接口，每次切换实时拉取。
      </p>
    </div>

    <div data-reveal>
      <FinancialGlobe client:only="react" />
    </div>
  </section>

  <!-- 特性区 -->
  <section id="highlights" class="py-24 px-6 max-w-7xl mx-auto">
    <div class="text-center mb-16" data-reveal>
      <div class="text-xs text-cyan-accent tracking-[0.3em] font-mono mb-3">WHY HERE</div>
      <h2 class="text-4xl md:text-5xl font-bold mb-4 text-text-primary leading-tight">
        不只是一份<span class="gradient-text">报告</span>
      </h2>
      <p class="text-text-secondary max-w-2xl mx-auto">
        从原始数据到投资判断的完整链路，可读、可查、可质疑
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-5">
      {features.map((f) => (
        <div class="glass p-6 group" data-reveal>
          <div class:list={["text-3xl mb-4", `text-${f.color}`]}>{f.icon}</div>
          <h3 class="text-lg font-semibold text-text-primary mb-2 group-hover:text-cyan-accent transition-colors">
            {f.title}
          </h3>
          <p class="text-sm text-text-secondary leading-relaxed">{f.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 最新研究 -->
  {latestReports.length > 0 && (
    <section class="py-24 px-6 max-w-7xl mx-auto">
      <div class="flex items-end justify-between mb-12" data-reveal>
        <div>
          <div class="text-xs text-cyan-accent tracking-[0.3em] font-mono mb-3">LATEST</div>
          <h2 class="text-4xl md:text-5xl font-bold text-text-primary leading-tight">
            最新<span class="gradient-text">研究</span>
          </h2>
        </div>
        <a
          href="/reports"
          class="hidden md:inline-flex items-center gap-1 text-sm text-text-secondary hover:text-cyan-accent transition-colors group"
        >
          全部研究
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {latestReports.map((r) => (
          <div data-reveal>
            <ReportCard report={r} />
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="py-24 px-6">
    <div class="max-w-4xl mx-auto glass p-12 md:p-16 text-center relative overflow-hidden" data-reveal>
      <div class="absolute -top-20 -left-20 w-60 h-60 rounded-full bg-cyan-accent/20 blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-20 -right-20 w-60 h-60 rounded-full bg-purple-accent/20 blur-3xl pointer-events-none"></div>

      <div class="relative">
        <h2 class="text-3xl md:text-4xl font-bold mb-4 text-text-primary">
          准备好<span class="gradient-text">深入</span>了吗
        </h2>
        <p class="text-text-secondary mb-8 max-w-xl mx-auto">
          浏览所有研究报告，按行业、时间、评级筛选你想看的内容
        </p>
        <a
          href="/reports"
          class="inline-flex items-center gap-2 px-8 py-3.5 rounded-lg bg-gradient-to-r from-cyan-accent to-purple-accent text-bg-base font-semibold hover:shadow-[0_0_40px_-4px_rgba(34,211,238,0.6)] transition-all"
        >
          浏览全部报告 →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.querySelectorAll<HTMLElement>("[data-reveal]").forEach((el) => {
    gsap.fromTo(
      el,
      { opacity: 0, y: 40 },
      {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: "expo.out",
        scrollTrigger: {
          trigger: el,
          start: "top 85%",
          toggleActions: "play none none none",
        },
      }
    );
  });
</script>
