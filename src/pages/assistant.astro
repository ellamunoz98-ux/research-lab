---
import BaseLayout from "../layouts/BaseLayout.astro";
import ChatPage from "../components/ChatPage.tsx";

const chatApi = import.meta.env.PUBLIC_COMMENTS_API as string | undefined;
---

<BaseLayout
  title="AI 研究助手"
  description="基于 Research.Lab 报告库 + DeepSeek 的 RAG 研究助手"
>
  {
    chatApi ? (
      <ChatPage client:only="react" apiUrl={chatApi} />
    ) : (
      <section class="max-w-2xl mx-auto px-6 py-20 text-center">
        <h1 class="text-3xl font-bold text-text-primary mb-3">AI 研究助手未启用</h1>
        <p class="text-text-secondary">
          站长尚未配置 <code class="font-mono text-cyan-accent">PUBLIC_COMMENTS_API</code>{" "}
          环境变量。
        </p>
      </section>
    )
  }
</BaseLayout>
