---
import BaseLayout from "../layouts/BaseLayout.astro";
import IndustryTreemap from "../components/IndustryTreemap.tsx";
---

<BaseLayout
  title="行业热力图"
  description="A 股 8 大热门行业 + 子板块实时热度，叠加龙头股动向 + 板块新闻，5 分钟自动刷新"
>
  <section class="pt-16 pb-10 px-6 max-w-7xl mx-auto">
    <div class="text-xs text-cyan-accent tracking-[0.3em] font-mono mb-4" data-reveal>
      INDUSTRY HEATMAP
    </div>
    <h1 class="text-5xl md:text-6xl font-bold leading-[1.1] mb-4 text-text-primary" data-reveal>
      行业<span class="gradient-text">热力图</span>
    </h1>
    <p class="text-lg text-text-secondary max-w-3xl leading-relaxed" data-reveal>
      8 大主线 · 40+ 热门子板块的实时热力分布。
      <strong class="text-text-primary">方格大小 = 主力资金净流入</strong>，
      <strong class="text-text-primary">方格颜色 = 当日涨跌</strong>（红涨绿跌）。
      <br class="hidden md:block" />
      点击任一格查看龙头股动向 + 媒体讨论焦点 —— 5 分钟自动刷新。
    </p>
  </section>

  <section class="px-6 max-w-7xl mx-auto pb-24" data-reveal>
    <IndustryTreemap client:only="react" />
  </section>
</BaseLayout>

<script>
  import { gsap } from "gsap";
  document.querySelectorAll<HTMLElement>("[data-reveal]").forEach((el, i) => {
    gsap.fromTo(
      el,
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, duration: 0.8, ease: "expo.out", delay: i * 0.08 }
    );
  });
</script>
